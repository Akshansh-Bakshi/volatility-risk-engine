# Template for environment-based configuration (see src/config.py).
#
# The application reads plain environment variables prefixed with VRE_; it does
# not load this file by itself.  Copy it to `.env` (git-ignored), adjust the
# values, and export them into your shell before launching, e.g.:
#
#   set -a && source .env && set +a
#
# (or use your IDE's / container runtime's env-file support).
# Blank values are treated as unset and fall back to the built-in default.
# Never put secrets in this template; it is committed to version control.

# Data-provider symbol requested by default.
VRE_DEFAULT_TICKER=^NSEI

# Default date range, YYYY-MM-DD.  Leave the end date blank for "latest available".
VRE_DEFAULT_START_DATE=2005-01-01
VRE_DEFAULT_END_DATE=

# Comma-separated VaR confidence levels as probabilities in (0, 1).
VRE_CONFIDENCE_LEVELS=0.95,0.99

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
VRE_LOG_LEVEL=INFO

# Optional rotating log file, e.g. logs/engine.log.  Blank = log to stderr only.
VRE_LOG_FILE=

# --- Data layer (src/data) -------------------------------------------------------------

# Root directory for generated datasets.  The market data cache lives in
# <dir>/cache/market/.  Blank = <repository>/data (git-ignored).  Relative paths are
# resolved against the working directory.
VRE_DATA_DIR=

# Price basis of the authoritative `close` series.  true (default) = adjusted for splits
# AND dividends (total-return basis); false = split-adjusted only.  See the README.
VRE_ADJUST_PRICES=true

# Minimum number of usable price observations for a download to be accepted.
VRE_MIN_OBSERVATIONS=250

# false = never read or write the on-disk cache.
VRE_USE_CACHE=true

# How long a "latest" download (no end date) counts as current, in hours.  Downloads whose
# explicit end date had clearly passed when fetched never expire.
VRE_CACHE_MAX_AGE_HOURS=6

# --- Preprocessing (src/preprocessing) --------------------------------------------------

# true = keep a latest price bar that may still be forming, i.e. one dated on or after the UTC
# date of the download.  false (default) excludes it, so only finalised observations reach the
# statistical and modelling layers.
VRE_INCLUDE_PROVISIONAL_BAR=false

# A return that skips MORE than this many consecutive weekdays without an observation is flagged
# as spanning a gap.  1 tolerates a single closure, which cannot be told apart from an ordinary
# exchange holiday without a trading calendar.
VRE_MAX_GAP_WEEKDAYS=1

# Minimum number of returns required to build a return series.
VRE_MIN_RETURNS=250
